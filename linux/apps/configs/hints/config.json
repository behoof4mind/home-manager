{
  "backends": {
    "enable": [
      "atspi",
      "opencv"
    ],
    "opencv": {
      "preload": false,
      "application_rules": {
        "default": {
          "kernel_size": 6,
          "canny_min_val": 180,
          "canny_max_val": 320
        },
        "TelegramDesktop": {
          "kernel_size": 4,
          "canny_min_val": 60,
          "canny_max_val": 140
        }
      }
    }
  },
  "hints": {
    "hint_height": 23,
    "hint_width_padding": 7,
    "hint_font_size": 13,
    "hint_background_a": 1,
    "hint_background_r": 1,
    "hint_background_g": 0.85,
    "hint_background_b": 0,
    "hint_font_r": 0,
    "hint_font_g": 0,
    "hint_font_b": 0,
    "hint_font_a": 1,
    "hint_inactive_layer_opacity": 0.92
  }
}
