{
  "backends": {
    "enable": ["atspi", "opencv"],
    "opencv": {
      "preload": false,
      "application_rules": {
        "default": {
          "kernel_size": 6,
          "canny_min_val": 180,
          "canny_max_val": 320
        }
      }
    }
  },
  "hints": {
    "hint_height": 20,
    "hint_width_padding": 6,
    "hint_font_size": 11,
    "hint_background_a": 0.9
  }
}
